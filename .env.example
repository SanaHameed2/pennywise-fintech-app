# Copy to .env (never commit .env). Both values come from Supabase > Project Settings > API.
# The anon key is a public, browser-side key; real protection comes from row-level security.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: shown in the footer / About page when set
VITE_REPO_URL=
VITE_CONTACT_EMAIL=
